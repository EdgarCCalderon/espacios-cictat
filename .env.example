# ─────────────────────────────────────────────────────────────
# Espacios CICTAT — Variables de entorno
# Copia este archivo como `.env` (o `.env.local`) y rellena los valores.
# Las variables con prefijo EXPO_PUBLIC_ se incrustan en el bundle del
# cliente: NUNCA pongas aquí la service_role key.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API → anon / public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_ANON_KEY
